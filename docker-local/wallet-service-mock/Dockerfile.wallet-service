FROM node@sha256:0085670310d2879621f96a4216c893f92e2ded827e9e6ef8437672e1bd72f437

WORKDIR /usr/src/app

RUN yarn global add json-server@0.17.4 --exact

RUN addgroup -S nonroot \
    && adduser -S nonroot -G nonroot \
    && chown -R nonroot:nonroot /usr/src/app

USER nonroot

CMD ["json-server", "/config/wallet-service-db.json", "--middlewares", "/config/middleware.js", "--host", "0.0.0.0"]
